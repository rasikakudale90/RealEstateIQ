# RealEstateIQ Backend Configuration Template
# Copy this file to .env and populate with deployment values. Never commit actual secrets.

PROJECT_NAME="RealEstateIQ API"
VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="development"
DEBUG=false

# Allowed CORS Origins (comma-separated URLs)
FRONTEND_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Supabase Authentication & Database Configuration
SUPABASE_URL="https://example-project.supabase.co"
SUPABASE_ANON_KEY="example-public-anon-key"
SUPABASE_SERVICE_ROLE_KEY="example-private-service-role-key"
SUPABASE_JWT_SECRET="example-jwt-secret"

# ML Model Configuration
MODEL_ARTIFACT_PATH="ml/inference/artifacts/house_price_pipeline.joblib"
MODEL_METADATA_PATH="ml/inference/artifacts/model_metadata.json"
TARGET_CURRENCY="INR"
