# RealEstateIQ Frontend Configuration Template
# Copy this file to .env.local and configure your environment variables. Never commit secrets.

# Supabase Client Configuration (Public anon key is safe for browser context)
NEXT_PUBLIC_SUPABASE_URL="https://example-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="example-public-anon-key"

# Backend FastAPI Service Base URL
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"
